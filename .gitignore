# macOS
.DS_Store

# Node
node_modules/
package-lock.json

# Swift / SwiftPM
.build/
*.xcodeproj
.swiftpm/

# Local agent/tooling state
.claude/

# The kit's own state: which files it installed and their hashes. It is
# rewritten on every install and sync, and it is per-machine.
.agents/.kitstate.json

# The GitNexus skills, written by `gitnexus setup`. The canonical copies are
# in .opencode/skills/ and .claude/skills/; this is a third copy that nothing
# refreshes, so it does not belong in the repository.
.agents/skills/

# Cloudflare Worker local state and secrets
.wrangler/
.dev.vars

# Build output
VisualiserMac/build/
VisualiserMac/dist/
dist/
VisualiserMac/Tests/eval-results/
.env

# Local git worktrees
.worktrees/

# Python bytecode from scripts/
__pycache__/
*.pyc

# PostHog wizard scratch files
.posthog-wizard-cache/

# Signing material. The Developer ID private key lives outside the repository
# (~/.vibresia-devid/), but a stray copy landing in the working tree should
# never be one `git add -A` away from being published.
*.key
*.pem
*.p12
*.csr
*.cer
*.mobileprovision

# macOS AppleDouble files from editors/sync tools
._*
.!*
chatgpt-plugin/*.zip
